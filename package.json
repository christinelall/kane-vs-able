{
  "name": "kane-vs-able",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Kane vs. ABLE \u2014 an AI Dungeon Master creates browser escape rooms and Kane proves whether they are solvable.",
  "scripts": {
    "start": "node scripts/server.mjs",
